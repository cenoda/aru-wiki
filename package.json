{
  "name": "aru-wiki",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/build-runtime-data.mjs",
    "dev": "vite",
    "prebuild": "node scripts/build-runtime-data.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "screenshot": "node scripts/dev/screenshot.mjs",
    "fetch:stage1": "node scripts/fandom/build-stage1.mjs",
    "fetch:series": "node scripts/fandom/build-series.mjs && node scripts/fandom/build-units.mjs",
    "fetch:characters": "node scripts/fandom/build-characters.mjs",
    "fetch:ko-names": "node scripts/fandom/build-ko-names.mjs",
    "fetch:lore": "node scripts/fandom/build-lore.mjs",
    "recommend:candidates": "node scripts/recommend/candidates.mjs",
    "recommend:judge": "node scripts/recommend/judge.mjs",
    "recommend:edges": "node scripts/recommend/edges.mjs",
    "test": "node --test \"scripts/**/*.test.mjs\""
  },
  "dependencies": {
    "@xyflow/react": "^12.12.1",
    "elkjs": "^0.12.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
